# ============================================================================
#  microservice-system / infrastructure
#  Copy thành .env rồi điền:   cp .env.example .env
#  .env đã nằm trong .gitignore, KHÔNG commit.
# ============================================================================

# --- PostgreSQL (superuser) -------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# 0.0.0.0 = mở ra LAN; đổi thành 127.0.0.1 nếu chỉ muốn truy cập nội bộ
POSTGRES_BIND=0.0.0.0

# --- Database riêng cho Keycloak (initdb tạo lần đầu) -----------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=doi-mat-khau-nay

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=doi-mat-khau-nay
KEYCLOAK_PORT=8180
KEYCLOAK_BIND=0.0.0.0

# URL mà người dùng/service bên ngoài gõ để tới Keycloak.
# PHẢI là IP hoặc tên miền thật của máy chủ, không phải localhost, nếu có
# client ở máy khác — giá trị này đi vào issuer của token và redirect OIDC.
# Ví dụ: http://192.168.102.254:8180
KEYCLOAK_HOSTNAME_URL=

KEYCLOAK_LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh
