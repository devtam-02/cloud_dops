# ============================================================================
#  microservice-system / infrastructure
#  Copy thành .env rồi điền:   cp .env.example .env
#  .env đã nằm trong .gitignore, KHÔNG commit.
# ============================================================================

# --- PostgreSQL (superuser) -------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# 0.0.0.0 = mở ra LAN; đổi thành 127.0.0.1 nếu chỉ muốn truy cập nội bộ
POSTGRES_BIND=0.0.0.0

# --- Database riêng cho Keycloak (initdb tạo lần đầu) -----------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=doi-mat-khau-nay

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=doi-mat-khau-nay
KEYCLOAK_PORT=8180
KEYCLOAK_HTTPS_PORT=8443
KEYCLOAK_BIND=0.0.0.0

# --- Chứng chỉ TLS (deploy-keycloak.sh dùng để sinh cert tự ký) -------------
KEYCLOAK_CERT_CN=keycloak.local
# Mọi địa chỉ client sẽ gõ đều phải có mặt ở đây, nếu không sẽ lỗi sai tên
# miền dù đã chấp nhận chứng chỉ tự ký. Thêm IP thật của máy chủ vào.
KEYCLOAK_CERT_SANS=DNS:keycloak.local,DNS:localhost,IP:127.0.0.1
KEYCLOAK_CERT_DAYS=365

# URL mà người dùng/service bên ngoài gõ để tới Keycloak.
# PHẢI là IP hoặc tên miền thật của máy chủ, không phải localhost, nếu có
# client ở máy khác — giá trị này đi vào issuer của token và redirect OIDC.
# Dùng HTTPS thì phải ghi https và đúng cổng 8443, ví dụ:
#   KEYCLOAK_HOSTNAME_URL=https://keycloak.local:8443
# Để http://...:8180 thì issuer và mọi link vẫn là HTTP dù 8443 đã mở.
KEYCLOAK_HOSTNAME_URL=

KEYCLOAK_LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh
