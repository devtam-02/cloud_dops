# ============================================================================
#  ELK — copy thành .env rồi điền:   cp .env.example .env
#  .env đã nằm trong .gitignore, KHÔNG commit.
# ============================================================================

ELK_VERSION=8.15.2

# --- Elasticsearch ----------------------------------------------------------
# Mật khẩu user `elastic` (superuser). Tối thiểu 6 ký tự.
ELASTIC_PASSWORD=doi-mat-khau-nay
ELASTIC_PORT=9200
# 0.0.0.0 = mở ra LAN; 127.0.0.1 nếu chỉ dùng nội bộ
ELASTIC_BIND=0.0.0.0
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Kibana -----------------------------------------------------------------
# Mật khẩu user hệ thống `kibana_system` (KHÁC mật khẩu elastic).
KIBANA_SYSTEM_PASSWORD=doi-mat-khau-nay
KIBANA_PORT=5601
KIBANA_BIND=0.0.0.0
KIBANA_LOCALE=en
# URL người dùng gõ để tới Kibana, ví dụ http://192.168.102.254:5601
KIBANA_PUBLIC_URL=
# Chuỗi ngẫu nhiên >= 32 ký tự. Sinh bằng:  openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=thay-bang-chuoi-ngau-nhien-32-ky-tu-tro-len

# --- Logstash ---------------------------------------------------------------
LS_JAVA_OPTS=-Xms256m -Xmx256m
LOGSTASH_BEATS_PORT=5044
LOGSTASH_TCP_PORT=5000
LOGSTASH_API_PORT=9600
