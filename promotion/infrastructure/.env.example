# ============================================================================
#  Hạ tầng promotion (local) — copy file này thành .env rồi điền giá trị thật
#      cp .env.example .env
#  .env đã nằm trong .gitignore, KHÔNG commit.
# ============================================================================

# --- Bí mật (bắt buộc, compose sẽ báo lỗi nếu thiếu) ------------------------
MARIADB_ROOT_PASSWORD=doi-mat-khau-nay
REDIS_PASSWORD=doi-mat-khau-nay
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=doi-mat-khau-nay

# --- Cổng publish ra host (tuỳ chọn, có giá trị mặc định) -------------------
MARIADB_PORT=3306
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=19092
KAFBAT_PORT=8989
MONGODB_PORT=27017
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
ELASTICSEARCH_PORT=9200

# --- Kafka nội bộ -----------------------------------------------------------
# Host mà listener EXTERNAL quảng bá. Để localhost nếu client chạy cùng máy;
# đổi thành IP/hostname thật của máy chủ nếu có client ở máy khác.
KAFKA_ADVERTISED_HOST=localhost
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Elasticsearch ----------------------------------------------------------
ES_JAVA_OPTS=-Xms512m -Xmx512m
