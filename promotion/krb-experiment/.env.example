# ============================================================
# Copy file nay thanh .env roi dien gia tri that:  cp .env.example .env
# Cấu hình chung cho stack Kafka + Kerberos
# ============================================================

# Realm Kerberos (viết HOA) và domain tương ứng (viết thường)
KRB5_REALM=KAFKA.LOCAL
KRB5_DOMAIN=kafka.local

# Mật khẩu master của KDC database và mật khẩu của principal admin
KDC_MASTER_PASSWORD=doi-mat-khau-nay
KDC_ADMIN_PASSWORD=doi-mat-khau-nay

# Hostname mà MỌI client (trong và ngoài docker) dùng để nối tới broker.
# Đây cũng chính là host trong Service Principal kafka/<host>@<REALM>.
# KHÔNG đổi thành IP: Kerberos/GSSAPI định danh theo hostname.
KAFKA_HOST=kafka.kafka.local
KDC_HOST=kdc.kafka.local

# Port publish ra ngoài
KAFKA_EXTERNAL_PORT=9094
KDC_PORT=88
KADMIN_PORT=749
KAFKA_UI_PORT=8080

# Cluster id cho KRaft (cố định để dữ liệu không bị mồ côi khi re-create)
CLUSTER_ID=kafka-krb5-cluster01

# Mật khẩu của các principal người dùng mẫu
CLIENT_PASSWORD=doi-mat-khau-nay
